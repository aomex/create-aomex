{
  "name": "create-aomex",
  "version": "0.0.94",
  "repository": "git@github.com:aomex/create-aomex.git",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "rm -rf hello-aomex && tsx src/index.ts --project=HelloAomex --pm=pnpm --orm=prisma --db=mysql --auth=bearer --docs=swagger --lang=zh-CN --dynamic-language=false --docker=true --tz=Asia/Shanghai --web-plugins=http-access-log,async-trace --logger=console,file --cluster=none",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:update": "DIR_SNAPSHOT_UPDATE=1 vitest run",
    "release": "release-it --ci",
    "build": "tsdown",
    "prepublishOnly": "tsdown"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "bin": "dist/index.js",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@aomex-contrib/oauth2-github": "0.1.0",
    "@aomex-contrib/oauth2-google": "0.1.0",
    "@aomex/async-trace": "4.4.0",
    "@aomex/auth": "4.4.0",
    "@aomex/auth-jwt-strategy": "4.4.0",
    "@aomex/cache": "4.4.0",
    "@aomex/cache-redis-adapter": "4.4.0",
    "@aomex/common": "4.4.0",
    "@aomex/compress": "4.4.0",
    "@aomex/console": "4.4.0",
    "@aomex/cors": "4.4.0",
    "@aomex/cron": "4.4.0",
    "@aomex/csrf": "4.4.0",
    "@aomex/etag": "4.4.0",
    "@aomex/helmet": "4.4.0",
    "@aomex/http-access-log": "4.4.0",
    "@aomex/logger": "4.4.0",
    "@aomex/logger-sentry": "4.4.0",
    "@aomex/logger-telegram": "4.4.0",
    "@aomex/mongoose": "4.4.0",
    "@aomex/oauth2-client": "4.4.0",
    "@aomex/openapi": "4.4.0",
    "@aomex/pretty-json": "4.4.0",
    "@aomex/prisma": "4.4.0",
    "@aomex/rate-limit": "4.4.0",
    "@aomex/redoc-ui": "4.4.0",
    "@aomex/response-time": "4.4.0",
    "@aomex/scalar-ui": "4.4.0",
    "@aomex/swagger-ui": "4.4.0",
    "@aomex/web": "4.4.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/yargs-parser": "^21.0.3",
    "dotenv": "^18.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "prisma-json-types-generator": "^6.0.1",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
