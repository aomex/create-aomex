# 初始化时从这里复制一份，并重命名为 .env{.xxx}
# 配置项有变化时建议及时同步该文件
DATABASE_URL=mysql://root:abcde@localhost:3306/snapshot-demo
TZ=UTC
REDIS_PASSWORD=abcde

# OAuth2 / OIDC / 微信（厂商后台回调须与路由一致；未启用项可保持注释）
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
